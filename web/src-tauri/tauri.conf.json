{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TacticMind",
  "version": "1.0.0",
  "identifier": "pl.tacticmind.game",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TacticMind",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#0f111a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "BoardGame",
    "shortDescription": "Szachowe zadania z AI, które myśli na głos",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
